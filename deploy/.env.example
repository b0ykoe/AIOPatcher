# AIOPatcher: Einstellungen für deploy/docker-compose.yml. Als ".env" neben die docker-compose.yml legen
# (oder in Portainer unter "Environment variables" → "Load variables from .env file" laden).
# Leer bzw. auskommentiert = Standardwert.

# Pflicht: DNS-Name oder IP, unter der die Agents den Server erreichen (steht im Server-Zertifikat)
AIOPATCHER_HOSTNAME=patch.example.com

# Image-Version: latest oder fest, z. B. 0.6.1
AIOPATCHER_VERSION=latest
# always = bei jedem "up"/Deploy das aktuelle Image holen; never bei selbst gebautem Image
#AIOPATCHER_PULL_POLICY=always

# Datenordner auf dem Host oder Name eines Docker-Volumes (z. B. aiopatcher-data)
#AIOPATCHER_DATA_PATH=/opt/aiopatcher/data

# Ports: Agents (mTLS, darf öffentlich sein), Dashboard (nur intern/VPN)
#AIOPATCHER_AGENT_PORT=8443
#AIOPATCHER_DASHBOARD_PORT=9443

# Sprache für Texte ohne Anfrage (Benachrichtigungen, Berichte): de oder en
AIOPATCHER_LANGUAGE=de
TZ=Europe/Berlin

# Reverse Proxy vor dem Dashboard (IPs/Netze, kommagetrennt), z. B. 127.0.0.1; leer = kein Proxy
#AIOPATCHER_TRUSTED_PROXIES=

# Funktionen, die nie eingeschaltet werden können, z. B. AppUpdates,OpnsenseUpdates
#AIOPATCHER_LOCKED_FEATURES=

# Hinweis auf neue AIOPatcher-Versionen; leer setzen (AIOPATCHER_UPDATE_CHECK_REPOSITORY=) = aus
#AIOPATCHER_UPDATE_CHECK_REPOSITORY=b0ykoe/AIOPatcher

# Nur für deploy/docker-compose.traefik.yml: E-Mail für Let's Encrypt, Ordner mit dynamic.yml und letsencrypt/
#ACME_EMAIL=admin@example.com
#TRAEFIK_CONFIG_PATH=/opt/aiopatcher/traefik
#TRAEFIK_VERSION=v3.4
