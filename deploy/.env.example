# AIOPatcher: settings for deploy/docker-compose.yml. Save as ".env" next to docker-compose.yml
# (or load it in Portainer under "Environment variables" → "Load variables from .env file").
# Empty or commented out = default value.

# Required: DNS name or IP under which the agents reach the server (goes into the server certificate)
AIOPATCHER_HOSTNAME=patch.example.com

# Image version: latest or pinned, e.g. 0.6.1
AIOPATCHER_VERSION=latest
# always = pull the current image on every "up"/deploy; never for a self-built image
#AIOPATCHER_PULL_POLICY=always

# Data folder on the host or name of a Docker volume (e.g. aiopatcher-data)
#AIOPATCHER_DATA_PATH=/opt/aiopatcher/data

# Ports: agents (mTLS, may be public), dashboard (internal/VPN only)
#AIOPATCHER_AGENT_PORT=8443
#AIOPATCHER_DASHBOARD_PORT=9443
# Proxy port (HTTP) for your own reverse proxy: hosts outside reach the internally running server through a
# public address (Settings → Public access). Expose on the LAN only; 0 = off
#AIOPATCHER_PROXY_PORT=8080

# Language for texts not tied to a request (notifications, reports): de or en
AIOPATCHER_LANGUAGE=de
TZ=Europe/Berlin

# Reverse proxy in front of the dashboard (IPs/networks, comma-separated), e.g. 127.0.0.1; empty = no proxy
#AIOPATCHER_TRUSTED_PROXIES=

# Features that can never be turned on, e.g. AppUpdates,OpnsenseUpdates
#AIOPATCHER_LOCKED_FEATURES=

# Notice about new AIOPatcher versions; set to empty (AIOPATCHER_UPDATE_CHECK_REPOSITORY=) = off
#AIOPATCHER_UPDATE_CHECK_REPOSITORY=b0ykoe/AIOPatcher

# Only for deploy/docker-compose.traefik.yml: email for Let's Encrypt, folder with dynamic.yml and letsencrypt/
#ACME_EMAIL=admin@example.com
#TRAEFIK_CONFIG_PATH=/opt/aiopatcher/traefik
#TRAEFIK_VERSION=v3.4
