<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <RootNamespace>AIOPatcher.Agent</RootNamespace>
    <AssemblyName>aiopatcher-agent</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- AOT-/Trim-Analyse auch beim normalen Build, damit Probleme unter Windows schon auffallen. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!--
    Publish-Varianten (immer eine einzelne Datei ohne installierte .NET-Runtime):
    - linux-x64:   Native AOT (klein, schnell). Muss auf Linux x64 gebaut werden. Abschaltbar mit -p:AgentNativeAot=false.
    - linux-arm64: Self-contained Single-File, getrimmt (kein Cross-Toolchain für AOT nötig).
    - win-x64:     Self-contained Single-File, nicht getrimmt (COM-Interop für Windows Update).
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64' and '$(AgentNativeAot)' != 'false'">
    <PublishAot>true</PublishAot>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != '' and '$(PublishAot)' != 'true'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('linux')) and '$(PublishAot)' != 'true'">
    <PublishTrimmed>true</PublishTrimmed>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AIOPatcher.Contracts\AIOPatcher.Contracts.csproj" />
  </ItemGroup>
</Project>
