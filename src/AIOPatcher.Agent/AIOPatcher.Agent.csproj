<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <RootNamespace>AIOPatcher.Agent</RootNamespace>
    <AssemblyName>aiopatcher-agent</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- AOT-/Trim-Analyse auch beim normalen Build, damit Probleme unter Windows schon auffallen. -->
    <IsAotCompatible>true</IsAotCompatible>
    <!-- LibraryImport (kernel32: CPU-Zeiten, Speicher) erzeugt Code mit Zeigern. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    Publish-Varianten (immer eine einzelne Datei ohne installierte .NET-Runtime):
    - linux-x64/arm64: Self-contained Single-File, getrimmt. Läuft ab glibc 2.27 (Ubuntu 18.04, Debian 10).
      Native AOT (-p:AgentNativeAot=true) wäre kleiner, übernimmt aber die glibc des Build-Rechners (Docker-SDK:
      2.34+), damit liefe der Agent auf Ubuntu 20.04/Debian 11 nicht mehr. Deshalb nur auf ausdrücklichen Wunsch.
    - win-x64:     Self-contained Single-File, nicht getrimmt (COM-Interop für Windows Update).
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64' and '$(AgentNativeAot)' == 'true'">
    <PublishAot>true</PublishAot>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != '' and '$(PublishAot)' != 'true'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('linux')) and '$(PublishAot)' != 'true'">
    <PublishTrimmed>true</PublishTrimmed>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!--
    Öffentlicher Release-Schlüssel für signierte Self-Updates (SPKI, Base64), z. B. im CI:
    dotnet publish … -p:AgentReleaseKey=MFkwEwYH…  Ohne Schlüssel installiert der Agent keine Updates selbst.
  -->
  <ItemGroup Condition="'$(AgentReleaseKey)' != ''">
    <AssemblyMetadata Include="AIOPatcher.ReleaseKey" Value="$(AgentReleaseKey)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AIOPatcher.Contracts\AIOPatcher.Contracts.csproj" />
  </ItemGroup>
</Project>
